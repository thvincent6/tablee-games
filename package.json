{
  "name": "tablee-games",
  "private": true,
  "description": "Catalogue public des jeux de Tablée et moteur de formules partagé",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p packages/engine",
    "test": "jest",
    "test:engine": "jest --coverage",
    "schema:export": "UPDATE_SCHEMA=1 jest packages/engine/src/definition/__tests__/json-schema.test.ts",
    "games:check": "tsx packages/engine/src/cli/games-check.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.5",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "jest": "~29.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22"
  }
}
